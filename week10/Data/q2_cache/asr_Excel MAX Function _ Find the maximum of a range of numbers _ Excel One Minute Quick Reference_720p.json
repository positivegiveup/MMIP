[{"start": 0.0, "end": 5.94, "text": "In today's Excel video, I'm going to show you how to use the Max function to find the highest value."}, {"start": 6.38, "end": 8.38, "text": "I've got a list of orders over here."}, {"start": 8.38, "end": 10.0, "text": "I want to find the highest value."}, {"start": 10.0, "end": 12.0, "text": "I can easily see that it's 30."}, {"start": 12.0, "end": 13.34, "text": "Two ways to do it."}, {"start": 13.34, "end": 16.04, "text": "I'm going to use AutoSum on the Home tab."}, {"start": 16.04, "end": 17.92, "text": "There is the word Max."}, {"start": 17.98, "end": 18.9, "text": "It has a blank."}, {"start": 18.9, "end": 19.9, "text": "I don't care."}, {"start": 19.9, "end": 21.96, "text": "The number 30 is correct."}, {"start": 21.96, "end": 23.04, "text": "I changed this."}, {"start": 23.04, "end": 24.94, "text": "Let's give Belgium 50."}, {"start": 24.94, "end": 26.86, "text": "The max is now 50."}, {"start": 27.38, "end": 34.94, "text": "If you don't like using the AutoSum in the top right, you can always just type this function yourself, B2"}, {"start": 34.94, "end": 41.28, "text": "colon B7 and there's 50."}, {"start": 41.3, "end": 42.88, "text": "Thank you for your time."}]